---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import KalamKudusDetails from '../../components/projects/KalamKudusDetails.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'kalam-kudus-lms' } },
    { params: { slug: 'warehouse-app' } },
    { params: { slug: 'diacheck-ai' } },
  ];
}

const { slug } = Astro.params;

// 1. Data for Premium Dark Layout Projects
const premiumProjects = {
  'kalam-kudus-lms': {
    titleKey: 'proj.kalam.titleHtml',
    descKey: 'proj.kalam.desc',
    contentKey: null,
    badges: [
      { key: 'proj.badge.edu', color: 'bg-blue-600/90 text-white border-blue-500/50', dot: false },
      { key: 'proj.badge.loc', color: 'bg-slate-800/80 text-slate-300 border-slate-700/80', dot: false },
      { key: 'proj.badge.status', color: 'bg-emerald-900/30 text-emerald-400 border-emerald-800/60', dot: true }
    ],
    stats: [
      { val: '9', labelKey: 'proj.stat.role' },
      { val: '13+', labelKey: 'proj.stat.module' },
      { val: '100%', labelKey: 'proj.stat.web' }
    ],
    heroImgPath: '../../assets/projects/kalamkudus/login-role.webp',
    heroImgExcludeFromGallery: 'login-role.webp',
    floatingLabel: 'Sekolah Kristen Kalam Kudus • Timika',
    galleryPrefix: 'kalamkudus'
  },
  'warehouse-app': {
    titleKey: 'proj.warehouse.titleHtml',
    descKey: 'proj.warehouse.desc',
    contentKey: 'proj.warehouse.content',
    badges: [
      { key: 'proj.warehouse.badge.type', color: 'bg-blue-600/90 text-white border-blue-500/50', dot: false },
      { key: 'proj.warehouse.badge.platform', color: 'bg-slate-800/80 text-slate-300 border-slate-700/80', dot: false },
      { key: 'proj.badge.status', color: 'bg-emerald-900/30 text-emerald-400 border-emerald-800/60', dot: true }
    ],
    stats: [
      { val: '5+', labelKey: 'proj.warehouse.stat1.label' },
      { val: 'Expo', labelKey: 'proj.warehouse.stat2.label' },
      { val: 'Firebase', labelKey: 'proj.warehouse.stat3.label' }
    ],
    heroImgPath: '../../assets/projects/warehouse/dashboar-warehouse-admin.png',
    heroImgExcludeFromGallery: 'dashboar-warehouse-admin.png',
    floatingLabel: 'Warehouse Stock Management',
    galleryPrefix: 'warehouse'
  },
  'diacheck-ai': {
    titleKey: 'proj.diacheck.titleHtml',
    descKey: 'proj.diacheck.desc',
    contentKey: 'proj.diacheck.content',
    badges: [
      { key: 'proj.diacheck.badge.type', color: 'bg-blue-600/90 text-white border-blue-500/50', dot: false },
      { key: 'proj.diacheck.badge.tech', color: 'bg-slate-800/80 text-slate-300 border-slate-700/80', dot: false },
      { key: 'proj.badge.status', color: 'bg-emerald-900/30 text-emerald-400 border-emerald-800/60', dot: true }
    ],
    stats: [
      { val: '76.43%', labelKey: 'proj.diacheck.stat1.label' },
      { val: '68.04%', labelKey: 'proj.diacheck.stat2.label' },
      { val: '61.19%', labelKey: 'proj.diacheck.stat3.label' }
    ],
    heroImgPath: '../../assets/projects/diacheckai/homepage.png',
    heroImgExcludeFromGallery: 'homepage.png',
    floatingLabel: 'Early Diabetes Classification',
    galleryPrefix: 'diacheckai'
  }
};

const premiumData = premiumProjects[slug as keyof typeof premiumProjects];

// Image groups
const imageGroups = {
  'kalamkudus': import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/kalamkudus/*.{jpeg,jpg,png,gif,webp}'),
  'warehouse': import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/warehouse/*.{jpeg,jpg,png,gif,webp}'),
  'diacheckai': import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/diacheckai/*.{jpeg,jpg,png,gif,webp}')
};

let galleryImages: Record<string, () => Promise<{ default: ImageMetadata }>> = {};
let galleryKeys: string[] = [];

if (premiumData) {
  galleryImages = imageGroups[premiumData.galleryPrefix as keyof typeof imageGroups] || {};
  
  const excludeImages = [premiumData.heroImgExcludeFromGallery];
  if (slug === 'kalam-kudus-lms') {
    excludeImages.push('virtual-class.webp', 'detail-course.webp', 'attandance-student.webp', 'payment-student.webp', 'book-library.webp');
  }
  
  galleryKeys = Object.keys(galleryImages).filter(key => !excludeImages.some(ex => key.includes(ex)));
}
---

<Layout title="Project Details - Wiranto Millennium Sitinjak">
  <Navbar />
  
  {premiumData ? (
    // PREMIUM DARK LAYOUT (Now Supports Light/Dark)
    <main class="pt-32 pb-32 bg-slate-50 dark:bg-[#0B1120] min-h-screen text-slate-800 dark:text-slate-300 font-sans transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
        
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-16 xl:gap-24 mb-24">
          <!-- Left Column -->
          <div class="flex flex-col justify-center">
            
            <a href="/#projects" class="inline-flex items-center text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white mb-10 transition-colors text-sm font-medium w-fit">
              <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span data-i18n="nav.back">Kembali ke Proyek</span>
            </a>

            <!-- Badges -->
            <div class="flex flex-wrap items-center gap-3 mb-8">
              {premiumData.badges.map(badge => (
                <span class={`px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide border flex items-center ${badge.color}`}>
                  {badge.dot && <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-2"></span>}
                  <span data-i18n={badge.key}>Loading...</span>
                </span>
              ))}
            </div>

            <!-- Title -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 dark:text-white mb-8 leading-tight tracking-tight" data-i18n={premiumData.titleKey}>
              Loading...
            </h1>

            <!-- Description -->
            <p data-i18n={premiumData.descKey} class="text-lg md:text-xl text-slate-600 dark:text-slate-300/90 leading-relaxed mb-12">
              Loading...
            </p>

            <hr class="border-slate-200 dark:border-slate-800/80 mb-10 transition-colors duration-300" />

            <!-- Stats -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-8">
              {premiumData.stats.map((stat, index) => (
                <div class={index === 2 ? "col-span-2 sm:col-span-1" : ""}>
                  <h4 class="text-3xl md:text-4xl font-extrabold text-blue-600 dark:text-blue-500 mb-2">{stat.val}</h4>
                  <p class="text-sm md:text-base text-slate-500 dark:text-slate-400 font-medium" data-i18n={stat.labelKey}>Loading...</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Right Column (Hero Image) -->
          <div class="relative flex items-center pt-8 xl:pt-0">
            <div class="relative w-full aspect-[4/3] sm:aspect-video xl:aspect-[4/3] rounded-[2rem] overflow-hidden shadow-2xl ring-1 ring-white/10 bg-slate-900">
              {galleryImages[premiumData.heroImgPath] && (
                <Image 
                  src={galleryImages[premiumData.heroImgPath]()} 
                  alt="Main Project Interface"
                  format="webp"
                  class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                />
              )}
            </div>
            <!-- Floating Badge -->
            <div class="absolute -bottom-5 left-4 md:left-10 bg-blue-600 text-white px-6 py-3.5 rounded-2xl shadow-xl shadow-blue-900/20 border border-blue-400/20 z-10 font-semibold text-sm md:text-base tracking-wide whitespace-nowrap">
              {premiumData.floatingLabel}
            </div>
          </div>
        </div>

        {premiumData.contentKey && (
          <div class="mt-16 mb-24 bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/60 p-8 md:p-12 rounded-3xl transition-colors duration-300 shadow-xl dark:shadow-none">
            <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-8 flex items-center">
              <span class="w-6 h-1 bg-indigo-500 mr-4 rounded-full"></span>
              <span data-i18n="proj.details.features">Key Features</span>
            </h2>
            <div data-i18n={premiumData.contentKey} class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed space-y-4">
              Loading...
            </div>
          </div>
        )}

        {slug === 'kalam-kudus-lms' && <KalamKudusDetails />}

        <!-- Gallery Section -->
        {galleryKeys.length > 0 && (
          <div class="mt-20 border-t border-slate-200 dark:border-slate-800/80 pt-20 transition-colors duration-300">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-12 flex items-center">
              <span class="w-8 h-1.5 bg-blue-600 dark:bg-blue-500 mr-4 rounded-full"></span>
              <span data-i18n="proj.gallery">Gallery Proyek</span>
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
              {galleryKeys.map(async key => {
                const filename = key.split('/').pop()?.replace('.webp', '').replace('.png', '').replace('.jpg', '').replace('.jpeg', '');
                const label = filename?.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
                const imageModule = await galleryImages[key]();
                const imageSrc = imageModule.default.src;
                
                return (
                  <div class="gallery-item rounded-2xl overflow-hidden shadow-xl dark:shadow-lg bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/50 group cursor-pointer aspect-video relative ring-1 ring-black/5 dark:ring-white/5 transition-colors duration-300" data-src={imageSrc} data-label={label}>
                    <Image 
                      src={galleryImages[key]()} 
                      alt={label || "Gallery Image"}
                      format="webp"
                      width={600}
                      height={338}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120]/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="absolute bottom-4 left-5 right-5 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 text-white font-medium text-sm md:text-base truncate drop-shadow-md">
                      {label}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

      </div>
    </main>
  ) : (
    <main class="pt-32 pb-16 bg-slate-50 dark:bg-slate-950 min-h-screen">
      <div class="text-center text-slate-500 mt-20 text-2xl font-bold">Project Not Found</div>
    </main>
  )}
  <Footer />

  <!-- Lightbox Container -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 flex flex-col items-center justify-center p-4">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors p-2 z-10">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    
    <div class="relative w-full max-w-5xl aspect-auto flex items-center justify-center flex-1">
      <img id="lightbox-img" src="" alt="Gallery Preview" class="max-w-full max-h-[80vh] object-contain drop-shadow-2xl rounded-lg" />
      
      <button id="lightbox-prev" class="absolute left-0 md:-left-16 text-white/50 hover:text-white transition-colors p-4 -translate-y-1/2 top-1/2">
        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      </button>
      
      <button id="lightbox-next" class="absolute right-0 md:-right-16 text-white/50 hover:text-white transition-colors p-4 -translate-y-1/2 top-1/2">
        <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
    
    <div id="lightbox-caption" class="text-white/80 font-medium text-lg mt-6 text-center tracking-wide"></div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const galleryItems = document.querySelectorAll('.gallery-item');
      const lightbox = document.getElementById('lightbox');
      if (!lightbox || galleryItems.length === 0) return;
      
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCaption = document.getElementById('lightbox-caption');
      const btnClose = document.getElementById('lightbox-close');
      const btnPrev = document.getElementById('lightbox-prev');
      const btnNext = document.getElementById('lightbox-next');
      
      let currentIndex = 0;
      const imagesData = Array.from(galleryItems).map(item => ({
        src: item.getAttribute('data-src'),
        label: item.getAttribute('data-label')
      }));

      function openLightbox(index) {
        currentIndex = index;
        updateLightbox();
        lightbox.classList.remove('opacity-0', 'pointer-events-none');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }

      function updateLightbox() {
        lightboxImg.src = imagesData[currentIndex].src;
        lightboxCaption.textContent = imagesData[currentIndex].label;
      }

      function prevImage() {
        currentIndex = (currentIndex - 1 + imagesData.length) % imagesData.length;
        updateLightbox();
      }

      function nextImage() {
        currentIndex = (currentIndex + 1) % imagesData.length;
        updateLightbox();
      }

      galleryItems.forEach((item, index) => {
        item.addEventListener('click', () => openLightbox(index));
      });

      btnClose.addEventListener('click', closeLightbox);
      btnPrev.addEventListener('click', (e) => { e.stopPropagation(); prevImage(); });
      btnNext.addEventListener('click', (e) => { e.stopPropagation(); nextImage(); });
      lightbox.addEventListener('click', (e) => {
        if(e.target === lightbox || e.target === lightboxImg.parentElement) closeLightbox();
      });
      
      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('opacity-0')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') prevImage();
        if (e.key === 'ArrowRight') nextImage();
      });
    });
  </script>
</Layout>
