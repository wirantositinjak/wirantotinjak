---
// src/components/Experience.astro

const experiences = [
  {
    roleKey: "exp.1.role",
    company: "REDPATH MINING",
    durationKey: "exp.1.duration",
    descKey: "exp.1.desc",
    techs: ["HR Administration", "Recruitment", "Communication", "Management"]
  },
  {
    roleKey: "exp.2.role",
    company: "PT. INOVASI DIGITAL NUSANTARA IDN",
    durationKey: "exp.2.duration",
    descKey: "exp.2.desc",
    techs: ["Project Management", "Agile", "Scrum", "Team Leadership"]
  },
  {
    roleKey: "exp.3.role",
    company: "WEB3 (Freelance)",
    durationKey: "exp.3.duration",
    descKey: "exp.3.desc",
    techs: ["Web3", "Software Infrastructure", "Engineering", "Blockchain"]
  },
  {
    roleKey: "exp.4.role",
    company: "BASETIPROJECT",
    durationKey: "exp.4.duration",
    descKey: "exp.4.desc",
    techs: ["Mobile UI", "React Native", "API Integration", "Frontend"]
  }
];
---

<section id="experience" class="py-24 bg-slate-50 dark:bg-slate-900 relative z-10 transition-colors duration-300 border-t border-slate-200 dark:border-slate-800/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <h2 data-i18n="exp.title" class="text-3xl md:text-5xl font-bold text-slate-800 dark:text-slate-100 mb-4 drop-shadow-sm">Work Experience</h2>
      <p data-i18n="exp.desc" class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto">
        My professional career journey in the tech industry leading up to my current stage.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="relative border-l-2 border-indigo-500 ml-4 md:ml-6 space-y-12 pb-4">
        
        {experiences.map((exp) => (
          <div class="relative pl-8 md:pl-12 group">
            
            <div class="absolute w-5 h-5 bg-white dark:bg-slate-900 border-4 border-indigo-500 rounded-full -left-[11px] top-1.5 group-hover:bg-indigo-500 transition-colors duration-300 shadow-[0_0_10px_rgba(99,102,241,0.4)]"></div>
            
            <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 p-6 md:p-8 rounded-2xl shadow-sm hover:shadow-lg dark:hover:shadow-[0_10px_30px_rgba(99,102,241,0.1)] hover:border-indigo-300 dark:hover:border-indigo-500/50 transition-all duration-300 hover:-translate-y-1">
              
              <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-3">
                <div>
                  <h3 data-i18n={exp.roleKey} class="text-xl md:text-2xl font-bold text-slate-800 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                    Loading...
                  </h3>
                  <h4 class="text-lg text-indigo-600 dark:text-indigo-400 font-semibold mt-1">
                    {exp.company}
                  </h4>
                </div>
                
                <span class="inline-flex items-start sm:items-center px-4 py-2 bg-indigo-50 text-indigo-700 dark:bg-slate-800 dark:text-indigo-300 text-sm font-semibold rounded-xl lg:rounded-full border border-indigo-100 dark:border-indigo-900/50">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2 mt-0.5 sm:mt-0 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span data-i18n={exp.durationKey} class="leading-snug">Loading...</span>
                </span>
              </div>
              
              <p data-i18n={exp.descKey} class="text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                Loading...
              </p>
              
              <div class="flex flex-wrap gap-2">
                {exp.techs.map(tech => (
                  <span class="px-3 py-1.5 text-xs font-medium text-slate-600 bg-slate-100 border border-slate-200 dark:text-slate-300 dark:bg-slate-800/80 dark:border-slate-700 rounded-lg shadow-sm">
                    {tech}
                  </span>
                ))}
              </div>

            </div>
          </div>
        ))}
        
      </div>
    </div>
    
  </div>
</section>
