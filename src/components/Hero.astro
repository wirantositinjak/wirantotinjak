---
// Hero.astro
---

<section id="home" class="relative min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-950 overflow-hidden pt-20 pb-16 transition-colors duration-300">
  
  <!-- Glow Background Effects (Light Mode: subtler, Dark Mode: prominent) -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-400/20 dark:bg-blue-600/20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-3xl animate-blob"></div>
    <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-purple-400/20 dark:bg-purple-600/20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-3xl animate-blob animation-delay-2000"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center mt-12 md:mt-0">
    
    <!-- Availability Badge -->
    <div class="inline-flex items-center space-x-2 bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-700/50 rounded-full px-4 py-2 mb-8 backdrop-blur-sm shadow-md dark:shadow-xl transition-transform hover:scale-105 duration-300 cursor-default">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
      </span>
      <span data-i18n="hero.badge" class="text-sm font-medium text-slate-600 dark:text-slate-300">Open for projects / full-time roles</span>
    </div>

    <!-- Name & Role -->
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-800 via-slate-600 to-slate-800 dark:from-slate-100 dark:via-blue-200 dark:to-slate-100 tracking-tight mb-4 drop-shadow-sm">
      Wiranto Millennium Sitinjak
    </h1>
    <h2 data-i18n="hero.title" class="text-2xl md:text-3xl font-bold text-blue-600 dark:text-blue-400 mb-6 drop-shadow-sm dark:drop-shadow-md">
      Software Engineer & Lead Designer
    </h2>

    <!-- Description -->
    <p data-i18n="hero.desc" class="mt-4 max-w-2xl text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed mx-auto mb-10">
      Combining technical expertise in software development with a user-centric design approach. Dedicated to creating digital solutions that are not only functional and scalable, but also deliver stunning visual experiences.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-5 justify-center w-full sm:w-auto">
      
      <!-- Primary Button -->
      <a href="#projects" class="group relative inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white transition-all duration-300 bg-blue-600 border border-transparent rounded-full hover:bg-blue-700 dark:hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600 focus:ring-offset-white dark:focus:ring-offset-slate-950 shadow-[0_4px_20px_rgba(37,99,235,0.2)] hover:shadow-[0_8px_30px_rgba(37,99,235,0.3)] dark:shadow-[0_0_20px_rgba(37,99,235,0.25)] dark:hover:shadow-[0_0_30px_rgba(37,99,235,0.4)] hover:-translate-y-1">
        <span data-i18n="hero.cta.projects">View Projects</span>
        <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      
      <!-- Secondary Button -->
      <a href="#contact" class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-slate-700 dark:text-slate-300 transition-all duration-300 bg-white/60 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-700 rounded-full hover:bg-slate-100 hover:border-slate-400 dark:hover:text-white dark:hover:bg-slate-800 dark:hover:border-slate-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-300 dark:focus:ring-slate-700 focus:ring-offset-white dark:focus:ring-offset-slate-950 backdrop-blur-md shadow-sm dark:shadow-lg hover:-translate-y-1">
        <span data-i18n="hero.cta.contact">Contact Me</span>
      </a>

    </div>
  </div>
</section>

<style>
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob {
    animation: blob 8s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
</style>
