---
// src/components/About.astro

const skills = [
  {
    category: "Frontend",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    techs: ["React", "Astro", "Next.js", "Tailwind CSS", "TypeScript"]
  },
  {
    category: "Backend & DB",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" /></svg>`,
    techs: ["Node.js", "Express", "FastAPI", "PostgreSQL", "MongoDB"]
  },
  {
    category: "AI & Tools",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    techs: ["Python", "LangChain", "Git", "Docker", "AWS"]
  },
  {
    category: "UI/UX Design",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`,
    techs: ["Figma", "Framer", "Prototyping", "Wireframing", "Design System"]
  }
];
---

<section id="about" class="py-24 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 relative z-10 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 mb-6 flex items-center">
          <span class="w-8 h-1 bg-blue-500 mr-4 rounded-full"></span>
          <span data-i18n="about.title">About Me</span>
        </h2>
        
        <div class="space-y-6 text-slate-600 dark:text-slate-400 text-lg leading-relaxed">
          <p data-i18n="about.p1">Loading...</p>
          <p data-i18n="about.p2">Loading...</p>
          <p data-i18n="about.p3">Loading...</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {skills.map(skill => (
          <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 p-6 rounded-2xl hover:-translate-y-1 hover:shadow-lg dark:hover:shadow-blue-500/10 transition-all duration-300">
            <div class="flex items-center space-x-3 mb-4">
              <div class="p-2 bg-blue-100 text-blue-600 dark:bg-blue-500/20 dark:text-blue-400 rounded-lg" set:html={skill.icon} />
              <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100">{skill.category}</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {skill.techs.map(tech => (
                <span class="px-2.5 py-1 text-xs font-semibold text-slate-700 bg-white border border-slate-200 dark:text-slate-300 dark:bg-slate-700/50 dark:border-slate-600 rounded-md shadow-sm">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
      
    </div>
  </div>
</section>
