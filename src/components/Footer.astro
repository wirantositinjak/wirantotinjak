---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 py-10 relative z-10 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="text-slate-500 dark:text-slate-400 text-sm font-medium">
      &copy; {currentYear} <span class="text-blue-600 dark:text-blue-400 font-semibold">Wiranto Millennium Sitinjak</span>. Hak Cipta Dilindungi.
    </div>
    
    <div class="flex flex-wrap justify-center items-center gap-6 text-sm font-medium text-slate-500 dark:text-slate-500">
      <a href="#about" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Tentang</a>
      <a href="#experience" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Pengalaman</a>
      <a href="#projects" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Proyek</a>
      <a href="#contact" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Kontak</a>
    </div>
  </div>
</footer>
