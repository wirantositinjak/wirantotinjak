---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/kalamkudus/*.{jpeg,jpg,png,gif,webp}');
---

<div class="mt-20">
  
  <!-- Section 1: Tech Stack -->
  <div class="py-16 border-t border-slate-200 dark:border-slate-800/80 transition-colors duration-300">
    <div class="text-center mb-16">
      <h4 class="text-blue-600 dark:text-blue-500 text-sm font-bold tracking-widest uppercase mb-4" data-i18n="kk.tech.title">Teknologi</h4>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white transition-colors duration-300" data-i18n="kk.tech.heading">Stack Teknologi</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      <div class="bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-6 shadow-xl dark:shadow-none transform hover:-translate-y-1 transition-all duration-300">
        <h5 class="text-blue-600 dark:text-blue-400 text-[10px] sm:text-xs font-bold uppercase mb-4" data-i18n="kk.tech.fe">Frontend</h5>
        <p class="text-slate-800 dark:text-slate-200 text-sm font-bold mb-2">Next.js</p>
        <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">Tailwind CSS</p>
      </div>
      <div class="bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-6 shadow-xl dark:shadow-none transform hover:-translate-y-1 transition-all duration-300">
        <h5 class="text-blue-600 dark:text-blue-400 text-[10px] sm:text-xs font-bold uppercase mb-4" data-i18n="kk.tech.be">Backend</h5>
        <p class="text-slate-800 dark:text-slate-200 text-sm font-bold mb-2">Laravel Rest API</p>
      </div>
      <div class="bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-6 shadow-xl dark:shadow-none transform hover:-translate-y-1 transition-all duration-300">
        <h5 class="text-blue-600 dark:text-blue-400 text-[10px] sm:text-xs font-bold uppercase mb-4" data-i18n="kk.tech.db">Database</h5>
        <p class="text-slate-800 dark:text-slate-200 text-sm font-bold mb-2">MySQL</p>
      </div>
      <div class="bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-6 shadow-xl dark:shadow-none transform hover:-translate-y-1 transition-all duration-300">
        <h5 class="text-blue-600 dark:text-blue-400 text-[10px] sm:text-xs font-bold uppercase mb-4" data-i18n="kk.tech.auth">Auth</h5>
        <p class="text-slate-800 dark:text-slate-200 text-sm font-bold mb-2">JWT</p>
        <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">Role-based Access</p>
      </div>
      <div class="bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-6 shadow-xl dark:shadow-none transform hover:-translate-y-1 transition-all duration-300">
        <h5 class="text-blue-600 dark:text-blue-400 text-[10px] sm:text-xs font-bold uppercase mb-4" data-i18n="kk.tech.cloud">Cloud</h5>
        <p class="text-slate-800 dark:text-slate-200 text-sm font-bold mb-2">Cloud VPS</p>
      </div>
      <div class="bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/50 rounded-2xl p-6 shadow-xl dark:shadow-none transform hover:-translate-y-1 transition-all duration-300">
        <h5 class="text-blue-600 dark:text-blue-400 text-[10px] sm:text-xs font-bold uppercase mb-4" data-i18n="kk.tech.cdn">CDN & Security</h5>
        <p class="text-slate-800 dark:text-slate-200 text-sm font-bold mb-2">Anti-DDoS</p>
        <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">SSL/HTTPS</p>
      </div>
    </div>
  </div>

  <!-- Section 2: Roles Grid -->
  <div class="py-20 border-t border-slate-200 dark:border-slate-800/80 mb-20 transition-colors duration-300">
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h4 class="text-blue-600 dark:text-blue-500 text-sm font-bold tracking-widest uppercase mb-4" data-i18n="kk.roles.title">Multi-Role System</h4>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-6 transition-colors duration-300" data-i18n="kk.roles.heading">9 Peran, Satu Platform</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed transition-colors duration-300" data-i18n="kk.roles.desc">Setiap peran mendapatkan dashboard, fitur, dan hak akses yang disesuaikan — memastikan setiap pengguna hanya melihat apa yang relevan untuk pekerjaan mereka.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1 -->
      <div class="bg-blue-50/50 dark:bg-[#0f172a] rounded-2xl p-6 border border-blue-100 dark:border-slate-800 flex items-center shadow-lg dark:shadow-2xl transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-600 flex items-center justify-center mr-4 flex-shrink-0 shadow-md shadow-blue-600/30 dark:shadow-blue-900/50">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-white font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.1.title">Super Admin</h5>
          <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.1.desc">Kendali penuh atas seluruh sistem & pengguna</p>
        </div>
      </div>
      <!-- 2 -->
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl p-6 shadow-lg dark:shadow-none border border-slate-200 dark:border-slate-700/50 flex items-center transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-900/50 flex items-center justify-center mr-4 flex-shrink-0 transition-colors duration-300">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-slate-200 font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.2.title">Admin</h5>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.2.desc">Operasional akademik & administrasi harian</p>
        </div>
      </div>
      <!-- 3 -->
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl p-6 shadow-lg dark:shadow-none border border-slate-200 dark:border-slate-700/50 flex items-center transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-900/50 flex items-center justify-center mr-4 flex-shrink-0 transition-colors duration-300">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-slate-200 font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.3.title">Guru</h5>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.3.desc">Kelola kelas, materi, dan interaksi siswa</p>
        </div>
      </div>
      <!-- 4 -->
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl p-6 shadow-lg dark:shadow-none border border-slate-200 dark:border-slate-700/50 flex items-center transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-900/50 flex items-center justify-center mr-4 flex-shrink-0 transition-colors duration-300">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-slate-200 font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.4.title">Kesiswaan</h5>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.4.desc">Pembinaan, pelanggaran & ekstrakurikuler</p>
        </div>
      </div>
      <!-- 5 -->
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl p-6 shadow-lg dark:shadow-none border border-slate-200 dark:border-slate-700/50 flex items-center transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-900/50 flex items-center justify-center mr-4 flex-shrink-0 transition-colors duration-300">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-slate-200 font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.5.title">Rohaniawan</h5>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.5.desc">Bimbingan rohani & konseling siswa</p>
        </div>
      </div>
      <!-- 6 -->
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl p-6 shadow-lg dark:shadow-none border border-slate-200 dark:border-slate-700/50 flex items-center transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-900/50 flex items-center justify-center mr-4 flex-shrink-0 transition-colors duration-300">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-slate-200 font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.6.title">Staf IT</h5>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.6.desc">Dukungan teknis & manajemen aset digital</p>
        </div>
      </div>
      <!-- 7 -->
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl p-6 shadow-lg dark:shadow-none border border-slate-200 dark:border-slate-700/50 flex items-center transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-900/50 flex items-center justify-center mr-4 flex-shrink-0 transition-colors duration-300">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-slate-200 font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.7.title">Staf Promosi</h5>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.7.desc">Penerimaan siswa baru & kampanye promosi</p>
        </div>
      </div>
      <!-- 8 -->
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl p-6 shadow-lg dark:shadow-none border border-slate-200 dark:border-slate-700/50 flex items-center transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-900/50 flex items-center justify-center mr-4 flex-shrink-0 transition-colors duration-300">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-slate-200 font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.8.title">Staf Sarana</h5>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.8.desc">Inventaris, gedung & peminjaman fasilitas</p>
        </div>
      </div>
      <!-- 9 -->
      <div class="bg-white dark:bg-slate-800/50 rounded-2xl p-6 shadow-lg dark:shadow-none border border-slate-200 dark:border-slate-700/50 flex items-center transform hover:scale-[1.02] transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-slate-900/50 flex items-center justify-center mr-4 flex-shrink-0 transition-colors duration-300">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        </div>
        <div>
          <h5 class="text-slate-900 dark:text-slate-200 font-bold mb-1 text-sm transition-colors duration-300" data-i18n="kk.role.9.title">Staf SDM</h5>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed transition-colors duration-300" data-i18n="kk.role.9.desc">Data kepegawaian, absensi & evaluasi kinerja</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 3: Feature Highlight 1 (Virtual Class) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-32">
    <div class="order-2 lg:order-1">
      <h3 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-6 transition-colors duration-300" data-i18n="kk.f1.title">Kelas Virtual (VClass)</h3>
      <p class="text-slate-600 dark:text-slate-300 text-lg mb-8 leading-relaxed transition-colors duration-300" data-i18n="kk.f1.desc">
        Guru dapat menyelenggarakan sesi pembelajaran online langsung dari platform. Siswa bergabung dengan tombol "Join Now" saat kelas berlangsung, atau "Join When Live" untuk kelas yang dijadwalkan berikutnya.
      </p>
      <ul class="space-y-4">
        <li class="flex items-center"><span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-500 flex items-center justify-center mr-4 text-sm transition-colors duration-300">✓</span><span class="text-slate-700 dark:text-slate-300 font-medium transition-colors duration-300" data-i18n="kk.f1.b1">Sesi live real-time per mata pelajaran</span></li>
        <li class="flex items-center"><span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-500 flex items-center justify-center mr-4 text-sm transition-colors duration-300">✓</span><span class="text-slate-700 dark:text-slate-300 font-medium transition-colors duration-300" data-i18n="kk.f1.b2">Informasi guru, kelas, dan jumlah peserta</span></li>
        <li class="flex items-center"><span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-500 flex items-center justify-center mr-4 text-sm transition-colors duration-300">✓</span><span class="text-slate-700 dark:text-slate-300 font-medium transition-colors duration-300" data-i18n="kk.f1.b3">Status jadwal: Live Now / Scheduled</span></li>
        <li class="flex items-center"><span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-500 flex items-center justify-center mr-4 text-sm transition-colors duration-300">✓</span><span class="text-slate-700 dark:text-slate-300 font-medium transition-colors duration-300" data-i18n="kk.f1.b4">Terintegrasi dengan jadwal dan kursus</span></li>
      </ul>
    </div>
    <div class="order-1 lg:order-2 relative rounded-3xl overflow-hidden ring-1 ring-black/5 dark:ring-white/10 shadow-2xl bg-slate-100 dark:bg-slate-900 group transition-colors duration-300">
      {images['../../assets/projects/kalamkudus/virtual-class.webp'] && (
        <Image src={images['../../assets/projects/kalamkudus/virtual-class.webp']()} alt="Virtual Class" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700" />
      )}
    </div>
  </div>

  <!-- Section 4: Feature Highlight 2 (Course Management) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-32">
    <div class="relative rounded-3xl overflow-hidden ring-1 ring-black/5 dark:ring-white/10 shadow-2xl bg-slate-100 dark:bg-slate-900 group transition-colors duration-300">
      {images['../../assets/projects/kalamkudus/detail-course.webp'] && (
        <Image src={images['../../assets/projects/kalamkudus/detail-course.webp']()} alt="Course Management" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700" />
      )}
    </div>
    <div>
      <h3 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-6 transition-colors duration-300" data-i18n="kk.f2.title">Manajemen Kursus & Materi</h3>
      <p class="text-slate-600 dark:text-slate-300 text-lg mb-8 leading-relaxed transition-colors duration-300" data-i18n="kk.f2.desc">
        Setiap mata pelajaran memiliki halaman khusus berisi sesi pembelajaran terstruktur, materi, tugas, dan progress bar yang menampilkan kemajuan belajar siswa secara visual.
      </p>
      <ul class="space-y-4">
        <li class="flex items-center"><span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-500 flex items-center justify-center mr-4 text-sm transition-colors duration-300">✓</span><span class="text-slate-700 dark:text-slate-300 font-medium transition-colors duration-300" data-i18n="kk.f2.b1">Progress bar per kursus (% sesi selesai)</span></li>
        <li class="flex items-center"><span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-600/20 text-blue-600 dark:text-blue-500 flex items-center justify-center mr-4 text-sm transition-colors duration-300">✓</span><span class="text-slate-700 dark:text-slate-300 font-medium transition-colors duration-300" data-i18n="kk.f2.b2">Materi bertahap: buku paket, slide, video</span></li>
